# Copy to .env for local development.
#
#   cp apps/api/.env.example apps/api/.env
#
# Before the first run, create the two database roles:
#
#   psql -d linck_dev -f apps/api/scripts/init-roles.sql
#
# THE APP MUST NOT CONNECT AS A SUPERUSER. Postgres exempts superusers from row
# level security entirely, so connecting as one leaves every tenant-isolation
# policy inert while everything appears to work — which is the one failure this
# design cannot tolerate. The API refuses to start if it detects this, in every
# environment including local.
LINCK_ENVIRONMENT=local

# The application role: owns nothing, has no BYPASSRLS.
LINCK_DATABASE_URL=postgresql+asyncpg://linck_app:linck_app@localhost:5432/linck_dev

# The migration role: owns the schema, runs Alembic, never serves a request.
LINCK_MIGRATION_DATABASE_URL=postgresql+psycopg://linck_migrator:linck_migrator@localhost:5432/linck_dev

# Leave the Google credentials empty locally and use POST /auth/dev-login,
# which runs the same identity-resolution path without contacting Google.
# The route 404s in any non-local environment.
LINCK_GOOGLE_CLIENT_ID=
LINCK_GOOGLE_CLIENT_SECRET=
LINCK_OAUTH_REDIRECT_URL=http://localhost:8000/auth/google/callback
LINCK_WEB_APP_URL=http://localhost:5173

# Generate a real one for anything that is not a laptop:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
LINCK_SESSION_SECRET=dev-only-not-a-secret-change-me

# WhatsApp Business Cloud API (LIN-13). Drivers send slip photos to the
# business number; Meta posts them to https://<api-host>/webhooks/whatsapp.
# From the Meta app dashboard: App secret, a system-user access token with
# whatsapp_business_messaging, and the business number's Phone number ID.
# The verify token is any string you also type into the dashboard.
LINCK_WHATSAPP_VERIFY_TOKEN=
LINCK_WHATSAPP_APP_SECRET=
LINCK_WHATSAPP_ACCESS_TOKEN=
LINCK_WHATSAPP_PHONE_NUMBER_ID=
# The organization (tenant) that owns this business number.
LINCK_WHATSAPP_ORGANIZATION_ID=

# Uploaded files (bill scans, WhatsApp slip photos). `local` keeps them under
# LINCK_FILE_STORAGE_DIR, as <org id>/<sha256>. Anything deployed uses `s3`, a
# private bucket (DigitalOcean Spaces; see docs/DEPLOY.md): the API refuses to
# start with `local` outside local development.
LINCK_FILE_STORE=local
LINCK_FILE_STORAGE_DIR=var/files
# LINCK_S3_ENDPOINT_URL=https://blr1.digitaloceanspaces.com
# LINCK_S3_REGION=blr1
# LINCK_S3_BUCKET=
# LINCK_S3_ACCESS_KEY_ID=
# LINCK_S3_SECRET_ACCESS_KEY=

# Industry news (LIN-10). Headlines come from Google News RSS: free, no key.
# A model writes one plain line about each, in English and in Tamil, over any
# OpenAI-compatible chat-completions endpoint. Until LINCK_AI_API_KEY is set,
# nothing is sent to any model: the screen shows the top headlines alone and
# says the AI summary is off.
#
# Google Gemini, free tier (the default). A key from https://aistudio.google.com/apikey.
# Google changes its free models now and then; check the current list at
# https://ai.google.dev/gemini-api/docs/models before choosing one.
LINCK_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LINCK_AI_MODEL=gemini-2.5-flash
LINCK_AI_API_KEY=
#
# Or instead, any of these (set all three):
#   OpenRouter, a model whose id ends in ":free" (list: https://openrouter.ai/models?max_price=0)
#     LINCK_AI_BASE_URL=https://openrouter.ai/api/v1
#     LINCK_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#     LINCK_AI_API_KEY=<your OpenRouter key>
#   Groq, free tier (key: https://console.groq.com/keys)
#     LINCK_AI_BASE_URL=https://api.groq.com/openai/v1
#     LINCK_AI_MODEL=llama-3.3-70b-versatile
#     LINCK_AI_API_KEY=<your Groq key>
#   Ollama on this server, with an open model (`ollama pull gemma3:12b`). Ollama
#   ignores the key, but one must be set for the AI to be on; a CPU needs time.
#     LINCK_AI_BASE_URL=http://localhost:11434/v1
#     LINCK_AI_MODEL=gemma3:12b
#     LINCK_AI_API_KEY=ollama
#     LINCK_AI_TIMEOUT_SECONDS=300
#   OpenCode Zen works the same way: https://opencode.ai/zen/v1, a free model from its list, its key.
#
# Seconds to wait for the model's answer.
# LINCK_AI_TIMEOUT_SECONDS=60
# The Google News searches, as a JSON list. The defaults are in app/core/settings.py.
# LINCK_NEWS_QUERIES=["Tamil Nadu construction", "Chennai real estate"]
